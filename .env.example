# Build-time defaults. Per-environment overrides without rebuilding: public/config.js
# (or MDR_ASSETS_BASE_URL / MDR_MODEL_TIER in the Docker image).

# Folder that contains models/ and snapshots/ (default: the site itself), e.g. a CDN or blob storage URL.
VITE_ASSETS_BASE_URL=
# Model version: auto | high | medium | low
VITE_MODEL_TIER=auto
# Serve the app from a sub-path, e.g. /mobila/ (default: /)
VITE_BASE_PATH=
